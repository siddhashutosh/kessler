# KESSLER backend configuration (copy to .env — never commit .env)

# Space-Track credentials (optional; without them KESSLER runs in Demo Mode)
KESSLER_SPACETRACK_USER=
KESSLER_SPACETRACK_PASS=

# Anthropic API key (optional; enables AI analyst briefings)
KESSLER_ANTHROPIC_API_KEY=

# Force demo mode even with credentials (true/false; default: auto)
# KESSLER_DEMO_MODE=true
