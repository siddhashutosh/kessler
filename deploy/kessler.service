[Unit]
Description=KESSLER Orbital Conjunction Assessment Toolkit
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/kessler/backend
ExecStart=/opt/kessler/backend/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=10
MemoryMax=280M
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
